# ---------------------------------------------------------------------------
# Aero Imports — Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).
# ---------------------------------------------------------------------------

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="https://www.aeroimports.com.br"

# Banco de dados — PostgreSQL online (ex.: Neon, https://neon.tech).
# Cole aqui a "connection string" que o painel do banco mostra (começa com
# postgresql://). Use a versão SEM "pooler" no endereço. No Vercel, cadastre
# a mesma variável em Settings > Environment Variables.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/NOMEDOBANCO?sslmode=require"

# NextAuth
# Gere um valor forte com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-e-seguro"
NEXTAUTH_URL="https://www.aeroimports.com.br"

# Armazenamento de mídia (Cloudinary — imagens, vídeos, banners)
# Cloud name: aparece no Dashboard do Cloudinary, logo no topo.
# Upload preset: crie em Settings > Upload > Upload presets > Add upload preset,
# com "Signing Mode" = Unsigned, e cole o nome dele aqui.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# WhatsApp Business (número com DDI+DDD, apenas números)
NEXT_PUBLIC_WHATSAPP_NUMBER="5541900000000"

# Analytics (opcional — deixar vazio para desativar)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Redis (opcional — recomendado em produção para rate limiting distribuído)
REDIS_URL=""

# E-mail transacional (recuperação de senha, confirmação de pedido)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Aero Imports <contato@aeroimports.com.br>"

# Não há gateway de pagamento integrado ao site: o checkout redireciona para
# o WhatsApp (ver src/lib/whatsapp.ts) e o pagamento é combinado por
# conversa direta com a equipe.
