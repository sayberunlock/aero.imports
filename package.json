    "@types/node": "20.14.14",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.40",
    "prisma": "5.17.0",
    "tailwindcss": "3.4.7",
    "tsx": "4.16.5"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "prisma": {
